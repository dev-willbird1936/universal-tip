# Set these as environment variables before starting the server. Never put keys in the extension.
# PARALLEL_API_KEY=
# DREX_API_KEY=
# Enable separately; paid external calls can incur charges. Default: disabled.
# ENABLE_PARALLEL=1
# Default Parallel Decisions transport is paid API. To opt into the documented free,
# unauthenticated Parallel MCP transport instead, set the two variables below.
# It sends public evidence to Parallel; no API key is sent by that transport.
# PARALLEL_DECISIONS_TRANSPORT=free_mcp
# PARALLEL_FREE_MCP_DAILY_CALL_LIMIT=0
# Parallel Search remains a separately enabled, keyed paid API.
# ENABLE_PARALLEL_SEARCH=1
# ENABLE_DREX=1
# Paid calls require both a shared daily count cap and a daily estimated-spend reservation cap.
# Set whole USD cents using conservative per-call upper bounds you have verified with the providers.
# Reservation limits do not guarantee actual provider charges; configure provider-side billing limits too.
# PROVIDER_DAILY_CALL_LIMIT=0
# PROVIDER_DAILY_BUDGET_CENTS=0
# PARALLEL_SEARCH_MAX_CENTS=0
# PARALLEL_DECISION_MAX_CENTS=0
# DREX_MAX_CENTS=0
# Optional stable local pairing token (32+ characters). If omitted, one is generated once and reused from data/local-token.
# LOCAL_API_TOKEN=
# Optional 32-byte registry encryption key as 64 hexadecimal characters.
# Without it, the research cache is memory-only and disappears at shutdown.
# CACHE_ENCRYPTION_KEY=
# Optional GitHub token for official API rate limits.
# GITHUB_TOKEN=
# Optional approved Reddit OAuth bearer token. Keep it on the backend; tokens expire.
# REDDIT_ACCESS_TOKEN=
# PayPal sandbox REST app credentials. Never use live credentials.
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# OpenRouter decision model. The key is normally entered in the extension popup (stored in data/settings.json).
# OPENROUTER_API_KEY=
# Other Drex models listed on OpenRouter on 2026-11-12 (untested here): nace-ai/drex-v1.5, nace-ai/drex-v2.0, nace-ai/drex-max-finance
# OPENROUTER_MODEL=nace-ai/drex-max
# OPENROUTER_DAILY_CALL_LIMIT=50
# Optional: how long a stored result is reused before its account ID is rechecked (milliseconds; default 600000 = 10 minutes).
# IDENTITY_RECHECK_AFTER_MS=600000
# Optional: how long public funding files, Sponsors pages and Keybase answers are remembered (milliseconds; default 600000).
# FETCH_MEMO_MS=600000
# Optional web-search leads (POST /leads, and part of the username search). The server POSTs { q, limit } as JSON to a
# search service you configure and reads { output: { results: [{ url, title, description }] } } back.
# Results are leads only; they never become confirmed payment links and never reach the decision model.
# WEB_SEARCH_URL=https://your-search-service.example/search
# WEB_SEARCH_HEADERS={"authorization":"Bearer ..."}
# LEADS_DAILY_LIMIT=25

# Optional profile lookup. The server forwards a username to a lookup service you run yourself and shows the platform
# names it reports as leads (never payment links). The address must answer GET ?target=<username> with JSON
# { ok: true, hits, results: [{ platform }] }. Off unless set.
# PROFILE_LOOKUP_URL=http://127.0.0.1:8791/search

# Live PayPal (real money). Off unless PAYPAL_ENV=live. Not exercised by the author; see README.
# PAYPAL_ENV=live
# PAYPAL_LIVE_CLIENT_ID=
# PAYPAL_LIVE_CLIENT_SECRET=
